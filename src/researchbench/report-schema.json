{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CAOShurong/researchbench/blob/master/src/researchbench/report-schema.json",
  "title": "ResearchBench Run Record",
  "description": "Schema for a single-model ResearchBench evaluation run record (RESEARCH_BENCHMARK.md Section 7.1)",
  "type": "object",
  "required": ["model", "timestamp", "benchmark_version", "average", "n_tasks", "results"],
  "properties": {
    "model": {
      "type": "string",
      "description": "Model or product identifier (e.g. 'gpt-4o', 'ChatGPT (GPT-4o)')"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp of the run"
    },
    "benchmark_version": {
      "type": "string",
      "description": "Semantic version of the benchmark suite"
    },
    "run_config": {
      "type": "object",
      "description": "Run configuration: model, tasks selected, capture_raw flag, etc.",
      "properties": {
        "model": { "type": "string" },
        "tasks": { "type": "array", "items": { "type": "string" } },
        "capture_raw": { "type": "boolean" }
      }
    },
    "average": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Mean score across all tasks"
    },
    "n_tasks": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of tasks evaluated"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task", "score"],
        "properties": {
          "task": {
            "type": "string",
            "description": "Task name (one of the 7 canonical names)"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Task score"
          },
          "details": {
            "type": "object",
            "description": "Task-specific scoring breakdown; structure depends on task (see TASK_DEFINITIONS.md)"
          },
          "raw_output": {
            "type": "string",
            "description": "All model responses for this task, joined by '---'"
          },
          "duration_seconds": {
            "type": "number",
            "description": "Wall-clock time for this task"
          },
          "evaluator_version": {
            "type": "string",
            "description": "Scorer version identifier (e.g. 'keyword-matching-v0.1')"
          }
        }
      }
    }
  }
}