# Normalize all text files to LF in the repository regardless of OS checkout
# defaults; render text fixtures deterministically.
* text=auto

# Explicit end-of-line policies for the file types we ship
*.py   text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf
*.cfg  text eol=lf
*.sh   text eol=lf

# Windows PowerShell scripts check in as CRLF is not required; LF is fine.
*.ps1  text eol=lf

# Binary assets are never normalized
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.zip    binary
*.gz     binary
*.whl    binary
*.egg    binary